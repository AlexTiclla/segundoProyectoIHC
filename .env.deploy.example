# Desarrollo Docker local por HTTP. Copia este archivo como .env.deploy.
SITE_ADDRESS=http://localhost
ENTORNO=desarrollo
COOKIE_SEGURA=false
RECUPERACION_SIMULADA=true

# Sustituye siempre este valor. Para produccion usa: openssl rand -hex 32
SECRETO_JWT=cambiar-por-un-secreto-aleatorio-largo
MINUTOS_SESION=120
MINUTOS_CODIGO_RECUPERACION=15
ZONA_HORARIA=America/La_Paz

# En una EC2 con dominio y HTTPS cambia a:
# SITE_ADDRESS=mascotas.ejemplo.com
# ENTORNO=produccion
# COOKIE_SEGURA=true
# RECUPERACION_SIMULADA=false
